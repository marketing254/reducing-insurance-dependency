}
.footer-menu-col.box-2:before{
	right: 90px;
}
.footer-menu-col.box-3:before{
	display: none;
}
.footer-menu-col-wrapper{
	padding-bottom: 58px;
	border-bottom: 3px dashed #dbeafb; 
	margin-bottom: 0 !important;
}
.copyright-poweredby {
	text-align: center;
	font-weight: 600;
	font-size: 16px;
	letter-spacing: 0.07em;
	text-transform: uppercase;
	padding-top: 38px;
}

@media screen and (max-width: 1600px){
	.affiliation-logo-wrapper{
		padding-left: 40px;
  		padding-right: 40px;
	}
}
@media screen and (max-width: 1440px){
	.footer-menu-col.box-2:before{
		right: 70px;
	}
}
@media screen and (max-width: 1440px){
	.footer-menu-col.box-2:before{
		right: 45px;
	}
}
@media screen and (max-width: 1280px){
	.footer-menu-col.box-1:before{
		right: 100px;
	}
	.footer-menu-col.box-2:before{
		right: 31px;
	}
	.footer-menu-col ul li a{
		font-size: 14px;
	}
}

@media screen and (max-width: 1090px){
	.footer-info-wrapper,.footer-bottom-wrapper{
		padding-left: 30px;
  		padding-right: 30px;
	}
	.affiliation-logo-carousel .item{
padding-top: 30px;
  padding-bottom: 30px;		
	}
}
@media screen and (max-width: 1090px){
	.footer-contact-info .ek-phone-numbers-wrapper .text{
		font-size: 14px;
	}
}
@media screen and (max-width: 991px){
	.footer-menu-col ul li a{
		font-size: 13px;
	}
	.book-a-meeting h2{
font-size: 30px;
  line-height: 60px;		
	}
	.footer-bottom{
		display: none;
	}
	.footer-info{
		padding-bottom: 130px;
	}
	.footer-contact-info .ek-phone-numbers-wrapper .text{
		display: block;
	}
	.footer-contact-info .ek-phone-numbers-wrapper .phone{
		font-size: 16px;
	}
}
@media screen and (max-width: 768px){
	.footer-info:before{
		width: 100%;
		display: none;
	}
	.book-a-meeting h2{
		text-align: center;
	}
	.book-a-meeting{
		text-align: center;
	}
	.footer-info:after{
		display: none;
	}
	.footer-info{
		background: var(--color_two);
		padding-bottom: 83px;
	}
	.footer-contact-info{
		text-align: center;
	}
	.footer-contact-info .address_direction_link{
		text-align: center;
		max-width: 100%;
		margin-right: auto;
	}
	.social-media{
		text-align: center;
		justify-content: center;
	}
	.footer-info-wrapper{
		background: var(--color_one);
		padding-top: 60px;
    padding-bottom: 60px;
	}
	.book-a-meeting h2{
		line-height: 47px;
	}
}
@media screen and (max-width: 580px){
	.book-a-meeting h2{
		font-size: 26px;
	}
	.affiliation-logo-wrapper{
		padding-left: 0;
    	padding-right: 0;
	}
	.affiliation-logo-carousel .owl-nav button.owl-prev{
		left: 0;
	}
	.affiliation-logo-carousel .owl-nav button.owl-next{
		right: 0;
	}
	.affiliation-logo-carousel .item{
padding-top: 20px;
    padding-bottom: 20px;		
	}
	.footer-contact-info .ek-phone-numbers-wrapper{
		font-size: 15px;
	}
}

