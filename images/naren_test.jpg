    }
    .btn-inverse:hover{
        background: var(--btn-color-one);
        color: var(--btn-color-two);
        border: 1px solid var(--btn-color-one);
    }
    .btn:focus, .btn.focus {
        outline: 0;
        box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.25);
    }*/
